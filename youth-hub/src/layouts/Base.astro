---
import "../styles/global.css";
import { site, categories } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  active?: string; // path of the current tab
  noindex?: boolean;
}
const { title, description = site.description, active, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} - ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {site.ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`}></script>
        <script is:inline define:vars={{ id: site.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag("js", new Date());
          gtag("config", id);
        </script>
      </>
    )}
    {site.adsenseClient && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`} crossorigin="anonymous"></script>
    )}
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="/">{site.name}</a>
        <nav class="tabs" aria-label="분야">
          {Object.values(categories).map((c) => (
            <a href={c.path} aria-current={active === c.path ? "page" : undefined}>{c.emoji} {c.label}</a>
          ))}
          <a href="/guide" aria-current={active === "/guide" ? "page" : undefined}>📘 가이드</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap">
        <p>
          <a href="/about">소개</a>
          <a href="/privacy">개인정보처리방침</a>
          <a href="/contact">문의</a>
        </p>
        <p>
          {site.name}는 각 기관이 공개한 공고를 정리해 안내하는 정보 사이트이며, 공고 기관과 관계가 없습니다.
          금액·자격·일정은 바뀔 수 있으니 신청 전 반드시 원문 공고를 확인하세요.
        </p>
      </div>
    </footer>
  </body>
</html>
