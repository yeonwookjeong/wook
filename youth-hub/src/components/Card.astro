---
import { daysLeft, methodLabel, type Item } from "../lib/items";

interface Props { item: Item }
const { item } = Astro.props;
const d = daysLeft(item.end);
const dday = d === null ? "상시" : d === 0 ? "오늘 마감" : `D-${d}`;
const ages = item.ages && (item.ages.min || item.ages.max)
  ? `만 ${item.ages.min ?? ""}~${item.ages.max ?? ""}세`.replace("~세", "세 이상")
  : null;
// Words the visitor's search should find this card by.
const haystack = [item.title, item.org, item.summary, item.benefit, item.hook, ...item.tags, ...item.regions].join(" ").toLowerCase();
---

<article
  class="card"
  data-search={haystack}
  data-regions={item.regions.join(",")}
  data-end={item.end ?? ""}
  data-value={item.valueKrw ?? 0}
>
  <div class="row">
    <span class:list={["badge", d !== null && d <= 3 ? "hot" : ""]} data-dday>{dday}</span>
    {item.method && <span class="badge gray">{methodLabel[item.method]}</span>}
    {item.pick && <span class="badge">추천</span>}
    {item.sample && <span class="badge gray">예시</span>}
  </div>
  <h3>{item.title}</h3>
  <div class="org">{item.org} · {item.regions.join(", ")}{ages && ` · ${ages}`}</div>
  <div class="benefit">{item.benefit}</div>
  <div class="hook">💡 {item.hook}</div>
  <div class="meta">{item.summary}</div>
  {item.tags.length > 0 && <div class="row">{item.tags.map((t) => <span class="badge gray">#{t}</span>)}</div>}
  <div class="meta">
    {item.end ? `마감 ${item.end.slice(5).replace("-", "월 ")}일` : "상시 모집"} · 확인 {item.updated}
  </div>
  <a class="go" href={item.url} target="_blank" rel="noopener nofollow">원문 공고 보기</a>
</article>
