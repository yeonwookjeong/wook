{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "permissions": {
    "ask": [
      "mcp__github__merge_pull_request",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)"
    ]
  }
}
