{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../jojeong/*"],
      "@common/*": ["../hundo-toss/src/*"],
      "iztro": ["./node_modules/iztro"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "@apps-in-toss/web-framework": ["./node_modules/@apps-in-toss/web-framework"]
    }
  },
  "include": ["src", "../hundo-toss/src/vite-env.d.ts", "../hundo-toss/src/shims.d.ts", "../jojeong/types/lunar-javascript.d.ts"]
}
