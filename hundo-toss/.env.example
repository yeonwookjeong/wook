# The site's address (jojeong/ on Vercel), no trailing slash. Its /api/toss/* routes check payments and write reports.
VITE_HUNDO_API=https://your-site.example
# The rewarded ad group id from the Apps in Toss console (인앱 광고 → 보상형). Empty in development: the test id is used.
VITE_AD_REWARDED=
# The banner ad group id (인앱 광고 → 배너). Empty in development: the test id is used.
VITE_AD_BANNER=
