# ─── Claude (소재 발굴 · 초안 생성) ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── 공개 이미지 호스팅 ──────────────────────────────────────────────────────
# 인스타/스레드 API 는 Meta 서버가 직접 내려받을 수 있는 공개 URL 을 요구한다.
# rendered/ 폴더가 이 URL 아래에 그대로 올라가 있어야 한다.
#   예) GitHub Pages:  https://<user>.github.io/<repo>/pipeline
#   예) 공개 레포 raw: https://raw.githubusercontent.com/<user>/<repo>/main/pipeline
PUBLIC_ASSET_BASE_URL=

# ─── Meta Graph API ────────────────────────────────────────────────────────
# 비워두면 v25.0 을 쓴다.
GRAPH_API_VERSION=v25.0
THREADS_API_VERSION=v1.0

# 채널별 토큰. 채널 id 를 대문자로, 하이픈은 밑줄로 바꾼 이름을 쓴다.
IG_TOKEN_TORYVEL=
IG_USER_ID_TORYVEL=
IG_TOKEN_HALGEO=
IG_USER_ID_HALGEO=
IG_TOKEN_MANTA=
IG_USER_ID_MANTA=
IG_TOKEN_WOOGI=
IG_USER_ID_WOOGI=

THREADS_TOKEN_TORYVEL=
THREADS_USER_ID_TORYVEL=

# ─── 로컬 브라우저 ──────────────────────────────────────────────────────────
# playwright 가 설치한 브라우저를 쓰면 비워둔다.
CHROMIUM_PATH=
